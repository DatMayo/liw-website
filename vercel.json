{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tasten.html",
      "destination": "/tasten",
      "permanent": true
    },
    {
      "source": "/handbuch.html",
      "destination": "/handbuch",
      "permanent": true
    },
    {
      "source": "/kulissen.html",
      "destination": "/kulissen",
      "permanent": true
    },
    {
      "source": "/trailer-werkzeug.html",
      "destination": "/trailer-werkzeug",
      "permanent": true
    },
    {
      "source": "/trailer-tool.html",
      "destination": "/trailer-tool",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/voice",
      "destination": "/api/voice"
    },
    {
      "source": "/client",
      "destination": "/api/client"
    }
  ]
}
